# Copy this file to .env and adjust for your machine.

# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Database (XAMPP MySQL defaults) ----
# Open phpMyAdmin (http://localhost/phpmyadmin) and create this database first:
#   CREATE DATABASE digital_clearance_db;
DB_HOST=localhost
DB_PORT=3306
DB_NAME=digital_clearance_db
DB_USER=root
DB_PASSWORD=

# ---- Auth ----
# Any long random string works for a course project. Change for production.
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# ---- Email (Nodemailer) ----
# Leave blank to use the built-in dev fallback, which just logs emails to the
# console/log file instead of sending them (see src/services/emailService.js).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Wollo University Clearance" <no-reply@wollo.edu.et>

# ---- Certificate verification ----
CERTIFICATE_VERIFY_BASE_URL=http://localhost:5173/verify
CERTIFICATE_VERIFICATION_YEARS=5

# ---- File uploads ----
MAX_UPLOAD_MB=5
